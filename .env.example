# =========================================================================
# Hot Dash - Variáveis de ambiente
# Copie para .env.local (dev) ou configure no EasyPanel (produção).
# =========================================================================

# ---- Login (uso próprio) --------------------------------------------------
# Credenciais de acesso à plataforma. Defina com seus valores.
AUTH_EMAIL=voce@exemplo.com
AUTH_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão de login (cookie). Gere com:
#   openssl rand -base64 32
SESSION_SECRET=

# ---- Criptografia das senhas das contas (AES-256) -------------------------
# Chave-mestra usada para cifrar as senhas guardadas. Gere com:
#   openssl rand -base64 32
# ⚠️ NUNCA troque depois de cadastrar senhas — elas ficariam ilegíveis.
APP_ENCRYPTION_KEY=

# ---- Endereço público do painel (OBRIGATÓRIO p/ o bot de vendas) ----------
# Domínio público pelo qual a internet alcança este app. É a base das URLs de
# webhook que registramos no Telegram e mandamos para a SyncPay.
#
# Sem isto, em produção o app não sabe o próprio endereço: rodando standalone
# no container ele resolve `http://0.0.0.0:3000` e o Telegram recusa o registro
# com "bad webhook: IP address 0.0.0.0 is reserved" — a operação do bot não liga.
#
# Exigências do Telegram: HTTPS, domínio de verdade (não IP interno), e porta
# 443, 80, 88 ou 8443.
#
# ⚠️ Use WEBHOOK_APP_URL, não NEXT_PUBLIC_APP_URL: qualquer NEXT_PUBLIC_* é
# embutida no BUILD, então defini-la só no runtime do EasyPanel não tem efeito.
WEBHOOK_APP_URL=https://painel.seudominio.com

# ---- Armazenamento na VPS -------------------------------------------------
# Diretório do banco (SQLite) e da mídia. No EasyPanel, monte um VOLUME
# PERSISTENTE neste caminho, senão os dados somem a cada deploy.
MEDIA_STORAGE_DIR=/app/data

# ---- Uploads --------------------------------------------------------------
# Limite de upload em MB — vale para a Galeria, o limpador de metadados e a
# censura por IA (imagem e vídeo). Padrão: 200.
#
# ⚠️ É NEXT_PUBLIC_*, ou seja, embutida no BUILD: mudar só no Environment do
# EasyPanel não tem efeito sem um novo deploy.
#
# ⚠️ Este é o limite DO PAINEL. O proxy na frente dele (Nginx/Traefik do
# EasyPanel, Cloudflare) tem o seu próprio e corta a requisição antes de ela
# chegar aqui — no Nginx, `client_max_body_size`. Vale o menor dos dois.
NEXT_PUBLIC_MAX_UPLOAD_MB=200

# ---- Pagamentos (opcional) ------------------------------------------------
# As CHAVES da SyncPay são configuradas na tela de Configurações
# (guardadas criptografadas no banco), não aqui. Só ajuste a base da API da
# SyncPay se a sua conta usar outro endpoint.
# SYNCPAY_BASE_URL=https://api.syncpayments.com.br

# ---- Censura por IA (NudeNet) ---------------------------------------------
# Endereço do microserviço de detecção (ver pasta nudenet-service/).
# OPCIONAL: dá para configurar tudo pela interface, em
#   Configurações → Conexão com IA → NudeNet (URL + token),
# sem variável de ambiente e sem redeploy. Estas variáveis servem só como
# fallback (ex.: quando se usa o docker-compose.yml, que já as define).
# NUDENET_URL=http://nudenet:8000
# NUDENET_API_KEY=
